      "description": "User preferences for layout, sorting, and last accessed folder",
      "fields": {
        "userId": { "type": "string", "description": "User ID" },
        "defaultViewMode": { "type": "string", "description": "Default view layout: grid or list" },
        "defaultSortBy": { "type": "string", "description": "Default sort attribute" },
